# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Meta / Facebook
META_APP_ID=123456789
META_APP_SECRET=abc123...

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_TOKEN=EAAxxxxx...
WHATSAPP_VERIFY_TOKEN=my_secure_verify_token_123

# Facebook Messenger
FB_PAGE_ID=123456789
FB_VERIFY_TOKEN=my_fb_verify_token_456
FB_PAGE_ACCESS_TOKEN=EAAxxxxx...

# Instagram
IG_ACCOUNT_ID=123456789
IG_ACCESS_TOKEN=EAAxxxxx...
IG_VERIFY_TOKEN=my_ig_verify_token_789

# Webhook Security
WEBHOOK_SECRET_WHATSAPP=random_secret_1
WEBHOOK_SECRET_INSTAGRAM=random_secret_2
WEBHOOK_SECRET_MESSENGER=random_secret_3

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHxxxxx...
VAPID_PRIVATE_KEY=xxxxx...

# App URL (for webhooks)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Supabase Anon Key (for Edge Functions)
SUPABASE_ANON_KEY=eyJxxx...
